# Ativa a camada de mocks (MSW + Socket.IO simulado).
# Use "true" para rodar 100% offline; "false" para apontar para uma API real.
VITE_ENABLE_MOCKS=true

# Base URL da API REST (usada pelo Axios).
VITE_API_URL=/api

# URL do servidor Socket.IO (vazio = mesma origem).
VITE_SOCKET_URL=

# Cenário determinístico inicial dos mocks. Ver README > Cenários.
# default | slow | flaky | offline | session-expired
VITE_MOCK_SCENARIO=default
